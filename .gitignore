# ---- data (never commit MovieLens: GroupLens licence forbids redistribution) ----
data/raw/
data/processed/
data/samples/*
!data/samples/README.md

# ---- model artifacts / experiment outputs ----
# artifacts/demo/.gitkeep is kept so `docker build` (COPY artifacts/demo/) works on a fresh clone;
# real demo bundles are fetched at app start from a GitHub Release asset (see docs/design.md).
artifacts/**
!artifacts/demo/
artifacts/demo/*
!artifacts/demo/.gitkeep
wandb/
mlruns/
*.ckpt
*.pt
*.pth
*.faiss
*.lgb
*.npy
*.npz

