# Template for .streamlit/secrets.toml. The real file is git-ignored (.gitignore) and kept
# out of the Docker build context (.dockerignore): never commit it.
#   Local:            cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   Community Cloud:  paste the same lines into the app's Settings > Secrets
#   Docker:           pass the key at run time instead: docker run -e ANTHROPIC_API_KEY ...
# Only the optional live LLM query-expansion path (Day 8) needs a key; the demo runs without
# it (example queries use precomputed expansions, and live calls are capped per session).
# Streamlit also exports root-level string keys as environment variables, so
# anthropic.Anthropic() picks up ANTHROPIC_API_KEY with no extra code.

ANTHROPIC_API_KEY = "replace-with-your-anthropic-api-key"
